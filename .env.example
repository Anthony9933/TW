# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Twilio ----------------------------------------------------------------
# Found at https://console.twilio.com. The auth token is also used to verify
# that incoming webhook requests really came from Twilio.
TWILIO_AUTH_TOKEN=

# Signature checking is ON whenever TWILIO_AUTH_TOKEN is set. Set to "false"
# only for local testing, where requests are not signed.
# TWILIO_VALIDATE_SIGNATURE=false

# Only needed if the public URL Twilio signs differs from the one this app
# sees (an unusual proxy setup). Must match the webhook URL in Twilio exactly.
# TWILIO_WEBHOOK_URL=https://your-app.vercel.app/api/webhook

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=

# --- Session storage -------------------------------------------------------
# REQUIRED in production. Without it the bot cannot remember anything between
# messages, because serverless functions do not keep state between requests.
#
# Use either the REST pair (recommended on serverless) ...
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ... or a single connection string (redis:// or rediss://):
# REDIS_URL=

# Vercel Marketplace prefixes injected variables with the database name
# (e.g. luna_KV_REST_API_URL). Those are detected automatically.

# How long a conversation survives without activity. Default 2592000 (30 days).
# SESSION_TTL_SECONDS=2592000

# Fail-fast tuning for an unresponsive database. Defaults shown.
# REDIS_TIMEOUT_MS=3000
# REDIS_BREAKER_THRESHOLD=3
# REDIS_BREAKER_COOLDOWN_MS=30000

# --- Operations dashboard (/dashboard) -------------------------------------
# Generate with: openssl rand -hex 32
# Signs the dashboard login cookie and doubles as an API bearer token.
DASHBOARD_SECRET=

# Sign-in credentials for the dashboard UI.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
